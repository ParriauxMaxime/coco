{
  "name": "cocopilot",
  "version": "0.1.0",
  "description": "Local workbench to run large features and PR stacks with Claude Code agents through Paseo: stack plan, code review, findings board, agent threads, checklist gates.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "paseo",
    "code-review",
    "pull-requests",
    "stacked-prs",
    "ai-agents",
    "workbench"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8778",
    "build": "vite build",
    "serve": "node server/index.ts",
    "start": "vite build && node server/index.ts",
    "test": "node --test server/*.test.ts \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@getpaseo/client": "0.13.0-beta.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^15.0.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
